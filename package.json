{
  "name": "proton-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted MCP server for Proton Mail via Proton Mail Bridge",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts stdio",
    "dev:http": "tsx src/index.ts serve",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json}\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "imapflow": "1.7.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
